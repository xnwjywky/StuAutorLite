# StuAutorLite Backend 环境配置
# 复制此文件为 .env 并根据需要修改
app_name=StuAutorLite
debug=true
database_url=sqlite:///./data/stuautor.db

# ── 安全（课堂/共享环境必读，详见 SECURITY_STABILITY_REVIEW.md / README）──

# P0-2 全站轻量鉴权：设置后所有 /api 请求须带 X-App-Key 头，否则 401。
# 留空 = 不启用鉴权（默认开发态）。生产/局域网部署务必设置并同步前端 VITE_APP_KEY。
# APP_KEY=

# P1-3 CORS 允许来源，逗号分隔（如 https://你的域名）。
# 除以下来源外，后端会自动放行回环 + 局域网私有网段（10./172.16-31./192.168.）任意端口，
# 支持「局域网其他设备经 http://<本机IP>:5173 访问」。
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# S-中-3 每 IP 每分钟最大 API 请求数（防 LLM 端点被刷产生费用）；0=关闭限流。
# RATE_LIMIT_PER_MINUTE=0
